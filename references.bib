@article{srai_distributed_2020,
	title = {Distributed manufacturing: a new form of localised production?},
	volume = {40},
	copyright = {https://www.emerald.com/insight/site-policies},
	issn = {0144-3577},
	shorttitle = {Distributed manufacturing},
	url = {https://www.emerald.com/insight/content/doi/10.1108/IJOPM-08-2019-0600/full/html},
	doi = {10.1108/IJOPM-08-2019-0600},
	abstract = {Purpose – The emergence of distributed manufacturing (DM) is examined as a new form of localised production, distinct from previous manifestations of multi-domestic and indigenous production. Design/methodology/approach – Supply network (SN) configuration and infrastructural provisioning perspectives were used to examine the literature on established localised production models as well as DM. A multiple case study was then undertaken to describe and explore the DM model further. A maximum variation sampling procedure was used to select five exemplar cases.},
