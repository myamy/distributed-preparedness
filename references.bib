@article{anaya_assessing_nodate,
	address = {Paper presented at Fab26},
	title = {Assessing {Data} {Availability} across {Maker}  {Networks}: {Measuring} {Information}  {Preparedness} for {Disaster} {Response}},
	abstract = {While the COVID-19 pandemic demonstrated the capacity of global maker networks to act as critical nodes in 
emergency supply chains, there remains a lack of formal assessment regarding their information readiness for 
future disaster response interventions. This study measures what data currently exists across maker ecosystem 
platforms and what would be required to activate them during a crisis. It performs a quantitative and geospatial 
analysis on ten online maker platforms compiled between 2021 and 2026 through the Internet of Production 
Alliance's Open-Know-Where (OKW) initiative, harmonized through a 20-class semantic taxonomy and 
evaluated using semantic intersection analysis and hierarchical clustering. The findings reveal a hard boundary 
dividing the sources into two tiers: operationally rich platforms detailing manufacturing processes, equipment, 
and materials, and directory-level sources providing only location registration — a systemic vulnerability, as the 
network's manufacturing intelligence depends on a small, fragile subset of sources. The study introduces the 
Distributed Manufacturing Data Kit (DMDK), an open pipeline for extracting, harmonizing, and visualising 
manufacturing data across incompatible platforms, and grounds the proposed Disaster Response Preparedness 
Index (DRPI) in the identified gaps, defining the data records that maker networks, NGOs, and policymakers 
should collect.},
	publisher = {Paper presented at Fab26},
	author = {Anaya, Antonio},
}

