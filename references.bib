	address = {New York},
	title = {University-{Community} {Partnershops} and {Equity} in {Making}},
	isbn = {978-1-4503-4802-7},
	doi = {10.1145/3003397.3003413},
	abstract = {In this collection of posters, we add to the community conversation on equity and access in making by considering the work of four UC Links sites. UC Links is a network of university-community partnerships with a long-standing focus on equity.},
