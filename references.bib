@book{campbell_making_2018,
	address = {White River Junction, Vermont},
	title = {Making massive small change: building the urban society we want},
	isbn = {978-1-60358-775-4},
	shorttitle = {Making massive small change},
	abstract = {"The key to fixing our broken patterns of urban development does not lie in grand plans or giant projects; rather, it lies in the collective wisdom and energy of people harnessing the power of many small ideas and actions to make a big difference. We call this making "Massive Small" change. In an increasingly complex and changing world where global problems are felt locally, the systems we use to plan, design, and build our urban neighborhoods are failing. For three generations, governments the world over have tried to order and control the evolution of cities through rigid, top-down action. Yet, master plans lie unfulfilled, housing is in crisis, the environment is under threat, and the urban poor have become poorer. The system is not broken: it was built this way. And governments alone cannot solve these problems. But there is another way–the Massive Small way–a concept developed by Kelvin Campbell, the innovative founder of Urban Initiatives, an internationally recognized urban design practice based in London, and curator of Smart Urbanism [Massive Small], one of the largest LinkedIn communities in the field of online urbanism"–},
	publisher = {Chelsea Green Publishing},
	author = {Campbell, Kelvin},
	year = {2018},
	keywords = {ARCHITECTURE / Urban \& Land Use Planning, Cities and towns, City planning, Environmental aspects, Growth, Land use, POLITICAL SCIENCE / Public Policy / City Planning \& Urban Development, POLITICAL SCIENCE / Public Policy / Regional Planning},
}

