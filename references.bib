@misc{samar_sabie_zhaoyang_li_clarice_wu_piya_sharma_ambareen_fatima_jessica_hu_unrealized_2025,
	title = {Unrealized {Networks}, {Reengaged} {Futures}: {Designing} {Place}-{Connecting} {Community} {Makerspace} {Infrastructure}},
	abstract = {This paper revisits an unrealized vision from the 1969 Erin Mills
NewTownplan, which imagined Erindale College (now the Univer
sity of Toronto Mississauga) as a central hub in a citywide educa
tional cable television network. Througharchivalresearchandinter
views with community members,librarystaff,andmunicipalpolicy
makers in Mississauga, we explore what technologically mediated
campus-community connectivity means today, and how it can in
formthedesign ofacontemporary,networkedmakerspaceplatform.
Our pilot study reveals strong interest in hands-on creative work,
alongside major gaps in awareness and accessibility—particularly among immigrants, newcomers, and youth. Participants empha
sized the need for visible, supportive entry points into making and
for coordinated infrastructure that reflects a diversity of practices
and needs. We propose positioning UTM as an “advocacy node”
within a broader Greater Toronto Area makerspace ecosystem. In
doing so, we develop a historically situated design framework for
inclusive and interdependent making infrastructure},
	author = {{Samar Sabie; Zhaoyang Li; Clarice Wu; Piya Sharma; Ambareen Fatima; Jessica Hu}},
	month = jul,
	year = {2025},
}

