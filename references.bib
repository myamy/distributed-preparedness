@book{gianni_responsible_2019,
	address = {Abingdon, Oxon ; New York, NY},
	title = {Responsible research and innovation: from concepts to practices},
	isbn = {978-1-138-20934-3},
	shorttitle = {Responsible research and innovation},
	abstract = {"Responsible Research and Innovation provides a comprehensive and impartial overview of the European Commission's Responsible Research and Innovation framework, including discussion of both the meaning and aims of the concept, and of its practical application. As a governance framework for research and innovation, RRI involves four key perspectives: ethical; economic/business; legal and governance; and political. The book is organised into chapters covering these different dimensions. The authors provide different viewpoints on these aspects, in order to offer guidance from experts in the field, while at the same time acknowledging the interpretative openness of the RRI frameworks"–},
