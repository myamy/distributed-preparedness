@incollection{hofer_roles_2024,
	address = {Wiesbaden},
	title = {The {Roles} of {Makerspaces} for {Facilitating} {Open}-{Source} {Hardware} {Development}},
	isbn = {978-3-658-44113-5 978-3-658-44114-2},
	url = {https://link.springer.com/10.1007/978-3-658-44114-2_17},
	doi = {10.1007/978-3-658-44114-2_17},
	abstract = {Abstract While free and open-source software has become a mature concept, open-source co-creation and sharing of hardware comes with the need for organizing a much more diverse set of disciplines and capabilities. A steadily growing number of companies develop open-source hardware (OSH) products based on the existing body of free technological knowledge today, with many of them manufactured in their own vicinity which in turn improves resource productivity and social benefits. Fab labs/makerspaces as openly accessible facilities with local communities of makers have the potential to act as catalysts to mature and disseminate OSH development collaboratively. In the Horizon 2020 project OPENNEXT, 17 case studies were implemented in four clusters where makerspaces worked together with small and medium-sized enterprises (SMEs) for a limited time to provide new pathways for OSH co-creation and sharing. Various consumer goods industries, such as electronics, furniture, and mobility amongst others, were in focus. Different roles within the development process emerged from this SME-makerspace-cooperation for OSH that will need to be upscaled and elaborated by makerspaces.},
	language = {de},
	urldate = {2024-07-30},
	booktitle = {Global collaboration, local production},
	publisher = {Springer Fachmedien Wiesbaden},
	author = {Hofer, Margit and Hassan, Mehera and Mies, Robert},
	editor = {Moritz, Manuel and Redlich, Tobias and Buxbaum-Conradi, Sonja and Wulfsberg, Jens P.},
	year = {2024},
	pages = {231--245},
}

